# Copy to .env.local for local development, or rely on a system environment variable.
# On Vercel: Project -> Settings -> Environment Variables. Never commit the real key.
GEMINI_API_KEY=

# Optional: force a specific model first (e.g. gemini-3.6-flash).
# Default order: gemini-flash-latest -> gemini-flash-lite-latest -> canned fallback.
GEMINI_MODEL=
